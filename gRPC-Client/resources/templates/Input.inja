import QtQuick 2.15
import QtQuick.Controls 2.15

Pane {
    {% include "_common_base_properties.inja" %}
    {% include "_common_behavior_properties.inja" %}
    {% include "_common_layout_properties.inja" %}
    property string text: "{{ default(text, "Button") }}"
    signal textModified(var newText)
    background: Rectangle {
        radius: 6
        border.width: 1
        color: "transparent"
        Behavior on color {
            ColorAnimation { duration: 200 }
        }
    }
    TextInput {
        anchors.fill: parent
        text: "{{ text }}"
        verticalAlignment: Text.AlignVCenter
        font.pixelSize: 16
        leftPadding: 10
        rightPadding: 10
        onTextChanged: {
            {{id}}.textModified(text)
        }
        clip: true
    }
    verticalPadding: 1
    horizontalPadding: 3
}