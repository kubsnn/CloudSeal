{% if exists("font_family") or exists("font_pointSize") or exists("font_bold") or exists("font_italic") or exists("font_underline") or exists("font_strikeout") %}
font: Qt.font({
    {% if exists("font_family") %}family: "{{ font_family }}",{% endif %}
    {% if exists("font_pointSize") %}pointSize: {{ font_pointSize }},{% endif %}
    {% if exists("font_bold") %}bold: {{ font_bold }},{% endif %}
    {% if exists("font_italic") %}italic: {{ font_italic }},{% endif %}
    {% if exists("font_underline") %}underline: {{ font_underline }},{% endif %}
    {% if exists("font_strikeout") %}strikeout: {{ font_strikeout }}{% endif %}
})
{% endif %}