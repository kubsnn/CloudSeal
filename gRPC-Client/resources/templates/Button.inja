import QtQuick 2.15
import QtQuick.Controls 2.15

Pane {
    {% include "_common_base_properties.inja" %}
    {% include "_common_behavior_properties.inja" %}
    {% include "_common_layout_properties.inja" %}
    property string text: "{{ default(text, "Button") }}"
    background: Rectangle {
        color: {{id}}.objectColor
        Behavior on color {
            ColorAnimation { duration: 200 }
        }
    }
    signal clicked()
        Text {
        anchors.centerIn: parent
        text: "{{ text }}"
        font.pixelSize: 16
    }
    MouseArea {
        width: parent.width
        height: parent.height
        anchors.centerIn: parent
        onClicked: {{id}}.clicked()
        hoverEnabled: true
        cursorShape: Qt.PointingHandCursor
        onContainsMouseChanged: {
            {{id}}.background.color = containsMouse ? {{id}}.objectColorOnHover : {{id}}.objectColor
        }
        onPressedChanged: {
            {{id}}.background.color = {{id}}.objectColorOnPress
        }
    }
}