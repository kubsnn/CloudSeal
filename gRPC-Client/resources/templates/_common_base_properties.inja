id: {{ id }}
{% if isString(visible) %}
visible: {{ visible }}
{% endif %}
{% set hasAnchors = isString(layout.anchors.left) or isString(layout.anchors.right) or isString(layout.anchors.top) or isString(layout.anchors.bottom) or isString(layout.anchors.fill) or isString(layout.anchors.centerIn) %}
{% if not hasAnchors %}
{% if isNumber(position.x) %}
x: {{ position.x }}
{% endif %}
{% if isNumber(position.y) %}
y: {{ position.y }}
{% endif %}
{% endif %}
{% if isNumber(size.width) %}
width: {{ size.width }}
{% endif %}
{% if isNumber(size.height) %}
height: {{ size.height }}
{% endif %}
{% if isString(type) %}
property var objectType: "{{ type }}" // e.g. "Button", "Text", "Image", etc.
{% endif %}