import QtQuick 2.15
import QtQuick.Controls 2.15

Rectangle {
    {% if isNumber(size.width) %}
    width: {{ size.width }}
    {% endif %}
    {% if isNumber(size.height) %}
    height: {{ size.height }}
    {% endif %}
    {% if isString(type) %}
    property var objectType: "{{ type }}"
    {% endif %}
    {% include "_common_behavior_properties.inja" %}
    {% if isString(color) %}
        color: "{{ color }}"
    {% endif %}
}